{
  "name": "quote-desk-demo",
  "version": "0.1.0",
  "description": "An agent on the Claude Agent SDK that works an RFQ for machined parts and returns a structured quote. All data is synthetic.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --test \"test/**/*.test.ts\"",
    "data": "node src/data/cli.ts write",
    "data:check": "node src/data/cli.ts check",
    "server": "node src/mcp/stdio.ts",
    "demo": "node bin/demo.ts",
    "demo:replay": "node bin/demo.ts --replay recordings/demo-unknown-material.jsonl",
    "eval": "node bin/eval.ts",
    "eval:holdout": "node bin/eval.ts --cases eval/cases-holdout.json --min-category-pass 0",
    "eval:replay": "node bin/eval.ts --replay recordings/eval-k3",
    "eval:replay:holdout": "node bin/eval.ts --cases eval/cases-holdout.json --min-category-pass 0 --replay recordings/eval-holdout-k3"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.321",
    "@modelcontextprotocol/sdk": "1.32.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "typescript": "7.0.2"
  }
}
